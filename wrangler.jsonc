{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-os",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Top level = local development (no Workers AI binding so `vite dev` works offline; AI calls fall back).
  "d1_databases": [
    { "binding": "DB", "database_name": "life-os-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "local-kv-placeholder" }],
  "triggers": { "crons": ["*/10 * * * *", "0 * * * *", "0 22 * * *"] },
  "vars": {
    "APP_NAME": "Life OS",
    "APP_ORIGIN": "http://localhost:5173",
    "ALLOWED_EMAILS": "namikyuu831@gmail.com",
    "DEV_LOGIN": "1"
  },
  "env": {
    // Production: `npm run deploy` → wrangler deploy --env production.
    // Fill database_id / kv id after `wrangler d1 create life-os-db` and `wrangler kv namespace create KV`.
    "production": {
      "ai": { "binding": "AI" },
      "d1_databases": [
        { "binding": "DB", "database_name": "life-os-db", "database_id": "2db897aa-549b-49d4-9507-e7c6bf88249d", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "5d5ca8a16d894d65ab844040066c1cd6" }],
      "triggers": { "crons": ["*/10 * * * *", "0 * * * *", "0 22 * * *"] },
      "vars": {
        "APP_NAME": "Life OS",
        "APP_ORIGIN": "https://life-os-production.namikyuu831.workers.dev",
        "ALLOWED_EMAILS": "namikyuu831@gmail.com"
      }
    }
  }
}
